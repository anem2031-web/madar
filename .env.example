PORT=3000
MADAR_RUNTIME_MODE=local
# For a verified TiDB environment, set MADAR_RUNTIME_MODE=connected and inject DATABASE_URL.
# Dedicated runtime-account setup is deferred by the user (WORK_PLAN.md D-055); the connection has not been switched.
# DATABASE_URL=
# DATABASE_TLS_CA_PEM=
# Connected authentication requires the exact browser origin (no trailing slash).
# APP_ORIGIN=http://127.0.0.1:3000
# AUTH_SECRET=  # Set a private random secret of at least 32 bytes; never commit it.
# MADAR_ADMIN_PASSWORD=  # Used only by the explicit db:bootstrap-admin command, then remove it.
